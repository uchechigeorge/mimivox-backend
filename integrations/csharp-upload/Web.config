<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Must match CUSTOM_UPLOAD_KEY in the backend .env -->
    <add key="UploadApiKey" value="12345678" />
    <!-- Where files are saved (relative to the site root) -->
    <add key="UploadRoot" value="~/uploads" />
    <!-- Optional: public URL prefix, e.g. a CDN. Leave out to use this site's URL. -->
    <!-- <add key="PublicBaseUrl" value="https://cdn.example.com/uploads" /> -->
  </appSettings>

  <system.web>
    <!-- No targetFramework here: inherits whatever the app pool / parent site uses -->
    <httpRuntime maxRequestLength="102400" executionTimeout="300" />
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 100 MB, in bytes -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
